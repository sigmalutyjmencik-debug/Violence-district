local function httpRequest(url, method, headers, body)
    local f = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
    if not f then return nil end
    local args = { Url = url, Method = method or "GET", Headers = headers or {} }
    if body then args.Body = body end
    local ok, res = pcall(f, args)
    if ok and res then return res else return nil end
end

local function sendMessage(text)
    if not CHAT_ID then return end
    local payload = { chat_id = CHAT_ID, text = text, parse_mode = "HTML" }
    httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/sendMessage", "POST",
        { ["Content-Type"] = "application/json" },
        HttpService:JSONEncode(payload))
end

local function getChatId()
    local res = httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates")
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result and #data.result > 0 then
            CHAT_ID = data.result[#data.result].message.chat.id
            return true
        end
    end
    return false
end

local playerList = {}
local function updatePlayerList()
    playerList = {}
    for i, p in pairs(Players:GetPlayers()) do
        playerList[i] = p
        playerList[p.Name:lower()] = p
    end
end

local function findPlayer(input)
    if not input or input == "" then return nil, "❌ Введи ник или номер" end
    updatePlayerList()
    
    -- Поиск по номеру
    local num = tonumber(input)
    if num and playerList[num] then
        return playerList[num]
    end
    
    -- Поиск по нику (полному или части)
    input = input:lower()
    local matches = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():find(input, 1, true) or p.DisplayName:lower():find(input, 1, true) then
            table.insert(matches, p)
        end
    end
    if #matches == 1 then return matches[1]
    elseif #matches > 1 then
        local names = {}
        for _, p in pairs(matches) do table.insert(names, p.Name) end
        return nil, "Найдено несколько: "..table.concat(names, ", ")
    else return nil, "Игрок не найден" end
end

