            "/players - список пользователей\n"..
            "/server - инфо о сервере\n"..
            "/rejoin - перезайти\n"..
            "/execute [код] - выполнить код\n"..
            "/setfps - ограничить FPS\n"..
            "/help - помощь")
        return
    end
    
    if cmd == "players" then
        local list = getScriptUserList()
        if #list == 0 then
            sendMessage("👥 Пользователей скрипта: 0")
        else
            sendMessage("👥 <b>Пользователи Spidi:</b>\n"..table.concat(list, "\n"))
        end
        return
    end
    
    if cmd == "server" then
        local placeName = MarketplaceService:GetProductInfo(game.PlaceId).Name
        local scriptCount = 0
        for _, p in pairs(Players:GetPlayers()) do
            if scriptUsers[p.UserId] then
                scriptCount = scriptCount + 1
            end
        end
        sendMessage("🖥️ Сервер: "..placeName.."\nID: "..game.PlaceId.."\nИгроков: "..#Players:GetPlayers().."\nПользователей Spidi: "..scriptCount)
