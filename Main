local function deleteOldFile()
    local delfile = syn and syn.delfile or delfile or fluxus and fluxus.delfile
    if delfile then
        pcall(delfile, "SpidiBackdoor.lua")
        print("[Spidi] ✅ Старый файл удалён")
    end
end
deleteOldFile()

