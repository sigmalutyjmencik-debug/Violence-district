            "/fling [ник] - флинг\n"..
            "/teleport [ник1] [ник2] - телепорт\n"..
            "/bring [ник1] [ник2] - притянуть\n"..
            "/loopkill [ник] - бесконечный килл\n"..
            "/stun [ник] - оглушить (3 сек)\n"..
            "/jump [ник] - прыжок\n"..
            "/spin [ник] [скорость] - крутить\n"..
